# =============================================================================
#  TRTC Twitch/Kick-style clone — environment configuration
# =============================================================================
#  HOW TO USE
#  ----------
#  1. Copy this file:           cp .env.example web/.env.local   (frontend)
#                               cp .env.example server/.env      (backend, prod path)
#  2. Fill in your own values from the TRTC Console:
#       Console:  https://console.trtc.io/app
#       App Management → SDKAppID + SDKSecretKey
#  3. NEVER commit the filled-in files. Only THIS .env.example is tracked in git.
#
#  Variables prefixed with VITE_ are read by the Vue/Vite frontend and are
#  embedded into the client bundle. Variables WITHOUT the VITE_ prefix are
#  server-only and must NEVER be exposed to the browser.
# =============================================================================


# -----------------------------------------------------------------------------
#  FRONTEND (web/.env.local)
# -----------------------------------------------------------------------------

# Your TRTC application's SDKAppID (a number). Required in BOTH modes.
# Find it in the TRTC Console → Application Management.
VITE_SDK_APP_ID=0

# Which mode the frontend uses to obtain a UserSig credential:
#   local  -> sign on the client using the test helper (FAST, DEV-ONLY, INSECURE)
#   server -> fetch a signed UserSig from your backend (SECURE, PRODUCTION)
# See docs/LOCAL_VS_PRODUCTION.md for the full explanation.
VITE_USERSIG_MODE=local

# ⚠️ DEV / LOCAL MODE ONLY ⚠️
# Your TRTC SDKSecretKey. Used ONLY when VITE_USERSIG_MODE=local to sign a
# UserSig directly in the browser. This BAKES YOUR SECRET KEY INTO THE CLIENT
# BUNDLE — anyone who opens devtools can read it. NEVER set this in a real
# deployment. Leave it blank when VITE_USERSIG_MODE=server.
VITE_SDK_SECRET_KEY=

# PRODUCTION MODE ONLY.
# The URL of your deployed UserSig endpoint (the Node server below).
# Used only when VITE_USERSIG_MODE=server. Example: https://my-app.onrender.com
VITE_USERSIG_SERVER_URL=http://localhost:3001


# -----------------------------------------------------------------------------
#  BACKEND (server/.env)  — production / server-signed path only
# -----------------------------------------------------------------------------

# Same SDKAppID as above (a number).
SDK_APP_ID=0

# Your TRTC SDKSecretKey. On the server this is SAFE — it never reaches the
# browser. This is the whole point of server-side signing.
SDK_SECRET_KEY=

# Port the UserSig server listens on.
PORT=3001

# Comma-separated list of allowed CORS origins (your frontend's URL).
# Example for local dev + a deployed frontend:
#   CORS_ORIGIN=http://localhost:5173,https://my-frontend.vercel.app
CORS_ORIGIN=http://localhost:5173

# How long an issued UserSig stays valid, in seconds. Keep this short in
# production (e.g. 3600 = 1 hour). Default below is 1 hour.
USERSIG_EXPIRE_SECONDS=3600

# Max /usersig requests per IP per minute (abuse protection).
RATE_LIMIT_PER_MINUTE=60

# Set to true when the server runs behind a load balancer / reverse proxy
# (Render, Fly, nginx, ALB…) so rate limiting sees the real client IP.
TRUST_PROXY=false

# pino log level: trace | debug | info | warn | error
LOG_LEVEL=info
