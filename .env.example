# =============================================================================
#  Kwitch — environment configuration (LiveKit)
# =============================================================================
#  cp .env.example web/.env.local   (frontend)
#  cp .env.example server/.env      (backend API)
#  NEVER commit filled-in env files.
# =============================================================================


# -----------------------------------------------------------------------------
#  FRONTEND (web/.env.local)
# -----------------------------------------------------------------------------

# LiveKit WebSocket URL for room.connect() — from cloud.livekit.io project settings.
VITE_LIVEKIT_URL=wss://your-project.livekit.cloud

# Token API base URL. Leave EMPTY for same-origin /token (recommended).
VITE_TOKEN_SERVER_URL=


# -----------------------------------------------------------------------------
#  BACKEND API (server/.env) — token signing + stream discovery
# -----------------------------------------------------------------------------

LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

PORT=3001
CORS_ORIGIN=http://localhost:5173
TOKEN_EXPIRE_SECONDS=3600
RATE_LIMIT_PER_MINUTE=60
TRUST_PROXY=false
LOG_LEVEL=info


# -----------------------------------------------------------------------------
#  CLOUDFLARE WORKERS (web/.dev.vars)
# -----------------------------------------------------------------------------
# LIVEKIT_URL, LIVEKIT_API_KEY, LIVEKIT_API_SECRET — same as server/.env
