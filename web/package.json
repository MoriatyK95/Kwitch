{
  "name": "trtc-twitch-clone-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Vue 3 frontend for a Twitch/Kick-style live-streaming demo built on the TRTC AtomicXCore Web SDK.",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "predev": "node scripts/preflight.mjs",
    "dev": "vite",
    "prebuild": "node scripts/preflight.mjs",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext .vue,.ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.{vue,ts,css}\"",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "js-sha256": "^0.11.0",
    "pako": "^2.1.0",
    "tuikit-atomicx-vue3": "^6.0.0",
    "vue": "^3.4.0",
    "vue-router": "^4.3.0"
  },
  "devDependencies": {
    "@tencentcloud/tuiroom-engine-js": "~4.1.1",
    "@tencentcloud/universal-api": "^2.4.0",
    "@types/node": "^20.12.0",
    "@types/pako": "^2.0.3",
    "@typescript-eslint/eslint-plugin": "^7.7.0",
    "@typescript-eslint/parser": "^7.7.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-vue": "^9.25.0",
    "prettier": "^3.2.5",
    "typescript": "^5.4.0",
    "vite": "^5.2.0",
    "vue-tsc": "^2.0.0"
  }
}
