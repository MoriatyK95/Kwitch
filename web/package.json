{
  "name": "kwitch-web",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "Kwitch — Vue 3 frontend for a live-streaming platform built on LiveKit.",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "predev": "node scripts/preflight.mjs",
    "dev": "vite",
    "prebuild": "node scripts/preflight.mjs",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "lint": "eslint . --ext .vue,.ts,.tsx",
    "lint:fix": "eslint . --ext .vue,.ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.{vue,ts,css}\"",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "livekit-client": "^2.9.0",
    "vue": "^3.4.0",
    "vue-router": "^4.3.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.7.0",
    "livekit-server-sdk": "^2.9.0",
    "@types/node": "^20.12.0",
    "@typescript-eslint/eslint-plugin": "^7.7.0",
    "@typescript-eslint/parser": "^7.7.0",
    "@vitejs/plugin-vue": "^5.2.4",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-vue": "^9.25.0",
    "prettier": "^3.2.5",
    "typescript": "^5.4.0",
    "vite": "^6.1.0",
    "vue-tsc": "^2.0.0",
    "wrangler": "^4.20.0"
  }
}
