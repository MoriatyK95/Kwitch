{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "kwitch",
  "compatibility_date": "2025-06-13",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./worker/index.ts",
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/token",
      "/streams",
      "/room-metadata",
      "/platform/*",
      "/channels/*",
      "/admin/*",
      "/health",
      "/healthz",
      "/readyz"
    ]
  },
  "observability": {
    "enabled": true
  }
}
